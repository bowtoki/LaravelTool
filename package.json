{
    "name": "laravel-json-editor",
    "version": "1.0.0",
    "description": "Laravel JSON Editor with formatting, validation and conversion",
    "private": true,
    "type": "module",
    "main": "public/js/json-editor.js",
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "build": "npm run production",
        "test": "jest"
    },
    "dependencies": {
        "axios": "^1.11.0",
        "jquery": "^3.6.0",
        "bootstrap": "^5.2.0"
    },
    "devDependencies": {
        "@popperjs/core": "^2.11.5",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^9.0.1",
        "jest": "^29.0.0",
        "laravel-mix": "^6.0.49",
        "lodash": "^4.17.19",
        "postcss": "^8.4.16",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.32.11",
        "sass-loader": "^12.0.0",
        "tailwindcss": "^4.0.0"
    }
}
